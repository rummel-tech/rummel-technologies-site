      },
      "base": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.1)"
        }
      },
      "md": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.12)"
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
